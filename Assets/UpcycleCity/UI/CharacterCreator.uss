/* Character Creator — kit look over the live 3D street backdrop (UpcycleCityPanelSettings, 1920x1080 reference).
   Charcoal rounded card with tabs on the left, white bold title + orange stage pill on the right,
   big round orange PLAY bottom-right, green selected options, ringed swatches.
   Kit: Orange #F26A1B, Green #2EAA5C, Yellow #F2C21B, charcoal rgba(30,32,35,0.95). */

.cc-root {
    flex-grow: 1;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.cc-stage {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

/* ---------------------------------------------------------------- top-left menu pill */
.cc-menu-pill {
    position: absolute;
    left: 32px;
    top: 26px;
    height: 62px;
    flex-direction: row;
    align-items: center;
    padding: 0 26px 0 18px;
    margin: 0;
    border-radius: 31px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    background-color: rgba(28, 30, 33, 0.9);
}
.cc-menu-pill:hover { background-color: rgb(46, 49, 54); }
.cc-menu-arrow {
    font-size: 40px;
    margin: -6px 10px 0 0;
    color: rgb(242, 106, 27);
}
.cc-menu-label {
    font-size: 24px;
    letter-spacing: 2px;
}

/* ---------------------------------------------------------------- right title column
   A fixed column on the right edge. The camera centres the character in the gap between the card and
   this column (CharacterCreatorController.TryGetFreeRegion), so the title never covers the player. */
.cc-brand {
    position: absolute;
    right: 40px;
    top: 120px;
    width: 27%;
    max-width: 560px;
    align-items: flex-end;
}
.cc-brand-logo {
    width: 100%;
    height: 130px;
    background-image: url("project://database/Assets/UpcycleCity/Art/UI/Logo/logo_upcycle_city.png");
    -unity-background-scale-mode: scale-to-fit;
    background-position-x: right;
}
.cc-brand-title {
    display: none;
    font-size: 64px;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-right;
    text-shadow: 0 4px 14px rgba(0, 0, 0, 0.7);
}
.cc-stage-pill {
    flex-direction: row;
    align-items: center;
    height: 46px;
    margin-top: 4px;
    padding: 0 22px 0 18px;
    border-radius: 23px;
    background-color: rgb(226, 98, 40);
}
.cc-stage-dot {
    width: 12px; height: 12px;
    margin-right: 10px;
    border-radius: 6px;
    background-color: rgb(255, 255, 255);
}
.cc-stage-text {
    font-size: 22px;
    letter-spacing: 1px;
}
.cc-brand-sub {
    margin-top: 12px;
    font-size: 24px;
    -unity-font-style: normal;
    -unity-text-align: upper-right;
    white-space: normal;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.7);
}

/* ---------------------------------------------------------------- appearance card */
.cc-panel {
    position: absolute;
    left: 32px;
    top: 112px;
    bottom: 40px;
    width: 600px;
    max-width: 38%;
    background-color: rgba(30, 32, 35, 0.95);
    border-radius: 26px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    overflow: hidden;
}
.cc-panel--collapsed {
    bottom: auto;
}

.cc-tabs {
    flex-direction: row;
    height: 84px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}
.cc-tab {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    border-bottom-width: 5px;
    border-bottom-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    font-size: 28px;
    color: rgb(150, 156, 162);
}
.cc-tab:hover { color: rgb(220, 224, 228); background-color: rgba(255, 255, 255, 0.03); }
.cc-tab--active {
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.22);
    border-bottom-color: rgb(242, 194, 27);
}
.cc-tab--hide { color: rgb(130, 136, 142); }

.cc-card-body { flex-grow: 1; }

.cc-title {
    margin: 24px 36px 0 36px;
    font-size: 32px;
    color: rgb(255, 255, 255);
}
.cc-subtitle {
    margin: 4px 36px 0 36px;
    font-size: 24px;
    -unity-font-style: normal;
    color: rgb(176, 181, 188);
}

.cc-scroll { flex-grow: 1; }
.cc-content { padding: 4px 36px 18px 36px; }

.cc-section-label {
    margin-top: 22px;
    margin-bottom: 12px;
    font-size: 26px;
    color: rgb(255, 255, 255);
}

.cc-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}
.cc-option {
    width: 49%;
    height: 72px;
    margin: 0 0 12px 0;
    border-width: 0;
    border-radius: 14px;
    font-size: 26px;
    color: rgb(230, 232, 234);
    background-color: rgb(66, 70, 77);
}
.cc-option:hover { background-color: rgb(82, 87, 95); }
.cc-option--selected,
.cc-option--selected:hover {
    background-color: rgb(46, 170, 92);
    color: rgb(255, 255, 255);
}

.cc-swatches {
    flex-direction: row;
    flex-wrap: wrap;
}
.cc-swatch {
    width: 62px;
    height: 62px;
    margin: 0 10px 10px 0;
    border-width: 4px;
    border-radius: 12px;
    border-color: rgba(0, 0, 0, 0);
}
.cc-swatch:hover { border-color: rgba(255, 255, 255, 0.35); }
.cc-swatch--selected,
.cc-swatch--selected:hover {
    border-color: rgb(255, 255, 255);
    scale: 1.08 1.08;
}

.cc-hint {
    margin-top: 8px;
    font-size: 21px;
    -unity-font-style: italic;
    color: rgb(150, 156, 160);
    white-space: normal;
}

.cc-footer {
    padding: 14px 30px 26px 30px;
    border-top-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}
.cc-turn-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}
.cc-turn-icon {
    font-size: 34px;
    color: rgb(176, 181, 188);
    margin-right: 14px;
}
.cc-turntable {
    flex-grow: 1;
    margin: 0;
}
.cc-turntable #unity-tracker {
    height: 10px;
    margin-top: -5px;
    border-radius: 5px;
    border-width: 0;
    background-color: rgb(66, 70, 77);
}
.cc-turntable #unity-dragger {
    width: 40px;
    height: 40px;
    margin-top: -20px;
    border-radius: 20px;
    border-width: 0;
    background-color: rgb(245, 245, 245);
}
.cc-random {
    height: 72px;
    margin: 0;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    font-size: 27px;
    color: rgb(255, 255, 255);
    background-color: rgb(58, 62, 68);
}
.cc-random:hover { background-color: rgb(74, 79, 86); }

/* ---------------------------------------------------------------- round PLAY */
.cc-play {
    position: absolute;
    right: 56px;
    bottom: 48px;
    width: 210px;
    height: 210px;
    margin: 0;
    padding: 0;
    border-radius: 105px;
    border-width: 9px;
    border-color: rgb(255, 255, 255);
    background-color: rgb(242, 106, 27);
    align-items: center;
    justify-content: center;
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}
.cc-play:hover { background-color: rgb(255, 124, 46); scale: 1.04 1.04; }
.cc-play:active { scale: 0.96 0.96; }
.cc-play--ready { background-color: rgb(46, 170, 92); }
.cc-play--ready:hover { background-color: rgb(58, 188, 106); }
.cc-play-icon {
    width: 0; height: 0;
    margin-left: 10px;
    border-left-width: 46px;
    border-top-width: 28px;
    border-bottom-width: 28px;
    border-left-color: rgb(255, 255, 255);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}
.cc-play-label {
    margin-top: 8px;
    font-size: 38px;
    letter-spacing: 3px;
    color: rgb(255, 255, 255);
}

/* ---------------------------------------------------------------- portrait phones */
.cc-root--portrait .cc-panel {
    left: 24px;
    right: 24px;
    width: auto;
    top: 52%;
    bottom: 24px;
}
.cc-root--portrait .cc-brand {
    left: 24px; right: 24px; width: auto; max-width: none;
    top: 110px;
    align-items: center;
}
.cc-root--portrait .cc-brand-logo { background-position-x: center; height: 110px; }
.cc-root--portrait .cc-brand-sub { display: none; }
.cc-root--portrait .cc-play {
    width: 150px; height: 150px; border-radius: 75px;
    bottom: auto; top: 30%;
}

/* ---------------------------------------------------------------- polish
   Title column gets a soft dark backing so the logo always reads (the street signs behind it vary). */
.cc-brand {
    padding: 22px 28px 20px 28px;
    border-radius: 32px;
    background-color: rgba(16, 18, 20, 0.5);
}
/* Swatches sized so skin tones (10) and outfit colours (9) fit the card without scrolling at 16:9 */
.cc-swatch {
    width: 48px;
    height: 48px;
    margin: 0 8px 8px 0;
    border-width: 3px;
    border-radius: 10px;
}
.cc-section-label { margin-top: 16px; margin-bottom: 10px; }
.cc-option { height: 64px; }
.cc-title { margin-top: 20px; }

/* Round PLAY: kit art; READY (co-op) keeps the flat green disc with its CSS triangle */
.cc-play {
    width: 220px;
    height: 220px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/UpcycleCity/Art/UI/Buttons/btn_round_play.png");
    -unity-background-scale-mode: scale-to-fit;
    justify-content: flex-end;
    padding-bottom: 46px;
}
.cc-play:hover { background-color: rgba(0, 0, 0, 0); }
.cc-play:active { background-image: url("project://database/Assets/UpcycleCity/Art/UI/Buttons/btn_round_play_pressed.png"); }
.cc-play-icon { display: none; }
.cc-play-label { margin-top: 0; font-size: 32px; }
.cc-play--ready,
.cc-play--ready:hover {
    background-image: none;
    background-color: rgb(46, 170, 92);
    border-width: 9px;
    border-color: rgb(255, 255, 255);
    justify-content: center;
    padding-bottom: 0;
}
.cc-play--ready .cc-play-icon { display: flex; }
.cc-play--ready .cc-play-label { margin-top: 8px; }
