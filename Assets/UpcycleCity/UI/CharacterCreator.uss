/* Character Creator: dark panel on the left, the character under a spotlight on the right.
   Brand: Company Green #2E8B57, Teal #2F8F8A, Safety Yellow #F2C21B, Player Hi-Vis Orange #FF7A1A. */

.cc-root {
    flex-grow: 1;
    -unity-font-style: bold;
}

.cc-stage {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.cc-title {
    position: absolute;
    top: 48px;
    left: 34%;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 34px;
    color: rgb(240, 240, 236);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
}

.cc-subtitle {
    position: absolute;
    top: 92px;
    left: 34%;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 17px;
    -unity-font-style: normal;
    color: rgb(160, 170, 172);
}

.cc-panel {
    position: absolute;
    left: 56px;
    top: 150px;
    bottom: 90px;
    width: 560px;
    background-color: rgb(40, 42, 44);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(58, 61, 64);
    overflow: hidden;
}

.cc-header {
    flex-direction: row;
    height: 64px;
    background-color: rgb(24, 25, 27);
}

.cc-header-title {
    flex-grow: 1;
    -unity-text-align: middle-center;
    font-size: 24px;
    color: rgb(236, 236, 232);
}

.cc-nav {
    width: 130px;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    font-size: 21px;
    -unity-font-style: bold-and-italic;
    color: rgb(255, 255, 255);
    background-color: rgb(47, 143, 138);
}

.cc-nav:hover { background-color: rgb(58, 166, 160); }
.cc-nav:active { background-color: rgb(36, 112, 108); }
.cc-nav:disabled { background-color: rgb(70, 74, 78); color: rgb(130, 134, 138); }

.cc-nav--start {
    background-color: rgb(242, 194, 27);
    color: rgb(30, 30, 28);
}
.cc-nav--start:hover { background-color: rgb(255, 210, 60); }

.cc-tabs {
    flex-direction: row;
    padding: 12px 18px 0 18px;
}

.cc-tab-dot {
    flex-grow: 1;
    height: 6px;
    margin: 0 4px;
    border-radius: 3px;
    background-color: rgb(70, 74, 78);
}

.cc-tab-dot--done { background-color: rgb(47, 143, 138); }
.cc-tab-dot--current { background-color: rgb(242, 194, 27); }

.cc-scroll { flex-grow: 1; }

.cc-content { padding: 6px 22px 22px 22px; }

.cc-section-label {
    margin-top: 18px;
    margin-bottom: 10px;
    font-size: 21px;
    color: rgb(236, 236, 232);
}

.cc-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.cc-option {
    width: 49%;
    height: 50px;
    margin: 0 0 8px 0;
    border-width: 0;
    border-radius: 3px;
    font-size: 19px;
    color: rgb(225, 227, 228);
    background-color: rgb(78, 82, 86);
}

.cc-option:hover { background-color: rgb(96, 101, 106); }

.cc-option--selected,
.cc-option--selected:hover {
    background-color: rgb(46, 139, 87);
    color: rgb(255, 255, 255);
}

.cc-swatches {
    flex-direction: row;
    flex-wrap: wrap;
}

.cc-swatch {
    width: 46px;
    height: 46px;
    margin: 0 8px 8px 0;
    border-width: 3px;
    border-radius: 4px;
    border-color: rgba(0, 0, 0, 0);
}

.cc-swatch:hover { border-color: rgba(255, 255, 255, 0.35); }

.cc-swatch--selected,
.cc-swatch--selected:hover { border-color: rgb(255, 255, 255); }

.cc-hint {
    margin-top: 6px;
    font-size: 15px;
    -unity-font-style: italic;
    color: rgb(150, 156, 160);
    white-space: normal;
}

.cc-footer {
    flex-direction: row;
    padding: 12px 18px;
    border-top-width: 1px;
    border-color: rgb(58, 61, 64);
}

.cc-random {
    flex-grow: 1;
    height: 46px;
    margin: 0;
    border-width: 0;
    border-radius: 3px;
    font-size: 18px;
    color: rgb(225, 227, 228);
    background-color: rgb(62, 66, 70);
}

.cc-random:hover { background-color: rgb(80, 85, 90); }

.cc-turntable {
    position: absolute;
    bottom: 40px;
    left: 52%;
    width: 30%;
}

/* The slider's own pieces: a slim track and a round knob, like the reference */
.cc-turntable #unity-tracker {
    height: 10px;
    margin-top: -5px;
    border-radius: 5px;
    border-width: 0;
    background-color: rgb(60, 63, 66);
}

.cc-turntable #unity-dragger {
    width: 34px;
    height: 34px;
    margin-top: -17px;
    border-radius: 17px;
    border-width: 0;
    background-color: rgb(190, 194, 196);
}

/* Portrait phones: panel along the bottom, character above it */
.cc-root--portrait .cc-panel {
    left: 24px;
    right: 24px;
    width: auto;
    top: 52%;
    bottom: 24px;
}

.cc-root--portrait .cc-title,
.cc-root--portrait .cc-subtitle { left: 0; }

.cc-root--portrait .cc-turntable {
    left: 20%;
    width: 60%;
    bottom: 49%;
}
