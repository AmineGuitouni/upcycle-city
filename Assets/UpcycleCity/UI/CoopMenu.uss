/* Co-op Play / Join / Lobby overlay — matches CharacterCreator.uss & Shop.uss dark slate + brand palette.
   Brand: Company Green #2E8B57, Teal #2F8F8A, Safety Yellow #F2C21B, Danger Red #C8463B.
   All buttons use >= 56px touch targets for mobile phones. */

.coop-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    -unity-font-style: bold;
}

.coop-overlay {
    flex-grow: 1;
    justify-content: center;
    align-items: flex-start;
    padding-left: 56px;
    padding-right: 24px;
    padding-top: 32px;
    padding-bottom: 32px;
}

.coop-panel {
    width: 580px;
    max-height: 92%;
    background-color: rgba(30, 32, 35, 0.95);
    border-radius: 18px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    overflow: hidden;
}

.coop-header {
    height: 68px;
    background-color: rgba(0, 0, 0, 0);
    justify-content: center;
    padding-left: 24px;
    padding-right: 24px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.coop-header-title {
    font-size: 25px;
    color: rgb(242, 242, 238);
    -unity-text-align: middle-left;
}

.coop-scroll {
    flex-grow: 1;
}

.coop-section {
    padding: 20px 24px 24px 24px;
}

.coop-label {
    font-size: 18px;
    color: rgb(216, 222, 224);
    margin-bottom: 8px;
}

.coop-label--spaced {
    margin-top: 18px;
}

.coop-input {
    margin: 0 0 14px 0;
    height: 54px;
}

.coop-input .unity-text-field__input {
    background-color: rgb(22, 24, 26);
    color: rgb(246, 246, 244);
    border-width: 1px;
    border-color: rgb(64, 68, 74);
    border-radius: 12px;
    padding-left: 14px;
    padding-right: 14px;
    font-size: 21px;
    -unity-text-align: middle-left;
}

.coop-input--code .unity-text-field__input {
    font-size: 26px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
}

.coop-toggle-row {
    flex-direction: row;
    margin-bottom: 12px;
}

.coop-toggle {
    flex-grow: 1;
    height: 52px;
    margin: 0 4px 0 0;
    border-width: 0;
    border-radius: 12px;
    font-size: 17px;
    color: rgb(220, 224, 228);
    background-color: rgb(62, 66, 72);
}

.coop-toggle--active {
    background-color: rgb(46, 170, 92);
    color: rgb(255, 255, 255);
}

.coop-btn {
    height: 60px;
    margin: 0 0 12px 0;
    border-width: 0;
    border-radius: 16px;
    font-size: 21px;
    color: rgb(255, 255, 255);
}

.coop-btn--small {
    height: 46px;
    font-size: 17px;
    margin-top: 8px;
    margin-bottom: 0;
}

.coop-btn--green { background-color: rgb(46, 170, 92); }
.coop-btn--green:hover { background-color: rgb(58, 188, 106); }

.coop-btn--orange { background-color: rgb(242, 106, 27); }
.coop-btn--orange:hover { background-color: rgb(255, 124, 46); }

.coop-btn--teal { background-color: rgb(47, 143, 138); }
.coop-btn--teal:hover { background-color: rgb(60, 168, 162); }

.coop-btn--amber {
    background-color: rgb(242, 194, 27);
    color: rgb(26, 26, 24);
}
.coop-btn--amber:hover { background-color: rgb(255, 212, 62); }

.coop-btn--muted {
    background-color: rgb(58, 62, 68);
    color: rgb(224, 228, 230);
}
.coop-btn--muted:hover { background-color: rgb(82, 88, 92); }

.coop-btn--danger { background-color: rgb(200, 70, 59); }
.coop-btn--danger:hover { background-color: rgb(224, 88, 76); }

.coop-btn:disabled {
    background-color: rgb(74, 78, 82);
    color: rgb(138, 142, 146);
}

.coop-banner {
    margin: 14px 24px 0 24px;
    padding: 12px 16px;
    border-radius: 14px;
    border-width: 1px;
}

.coop-banner--error {
    background-color: rgba(168, 42, 36, 0.92);
    border-color: rgb(235, 108, 96);
}

.coop-banner--info {
    background-color: rgba(36, 98, 108, 0.92);
    border-color: rgb(92, 192, 186);
}

.coop-banner-text {
    font-size: 16px;
    -unity-font-style: normal;
    color: rgb(255, 255, 255);
    white-space: normal;
}

.coop-code-row {
    flex-direction: row;
    align-items: stretch;
    margin-bottom: 16px;
}

.coop-code-badge {
    flex-grow: 1;
    padding: 16px 14px;
    background-color: rgb(20, 22, 24);
    border-radius: 14px;
    border-width: 2px;
    border-color: rgb(242, 194, 27);
    font-size: 24px;
    color: rgb(242, 194, 27);
    -unity-text-align: middle-center;
    letter-spacing: 2px;
}

.coop-code-copy-btn {
    min-width: 112px;
    min-height: 56px;
    margin: 0 0 0 10px;
    padding: 0 16px;
    border-width: 0;
    border-radius: 14px;
    background-color: rgb(58, 62, 68);
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-text-align: middle-center;
}

.coop-code-copy-btn:hover {
    background-color: rgb(60, 168, 162);
}

.coop-code-copy-btn--copied {
    background-color: rgb(46, 170, 92);
}

.coop-roster {
    margin-bottom: 14px;
}

.coop-roster-row {
    flex-direction: row;
    align-items: center;
    height: 52px;
    padding-left: 14px;
    padding-right: 14px;
    margin-bottom: 8px;
    background-color: rgb(44, 47, 52);
    border-radius: 12px;
}

.coop-roster-slot {
    width: 48px;
    height: 32px;
    margin-right: 12px;
    border-radius: 10px;
    background-color: rgb(242, 106, 27);
    color: rgb(255, 255, 255);
    font-size: 17px;
    -unity-text-align: middle-center;
}

.coop-roster-name {
    font-size: 19px;
    color: rgb(236, 240, 242);
}

.coop-hint {
    font-size: 16px;
    -unity-font-style: normal;
    color: rgb(168, 176, 180);
    margin-bottom: 16px;
    white-space: normal;
}

/* Portrait phones: bottom sheet layout matching CharacterCreator.uss */
.coop-root--portrait .coop-overlay {
    justify-content: flex-end;
    align-items: stretch;
    padding: 20px;
}

.coop-root--portrait .coop-panel {
    width: auto;
    max-height: 62%;
}

/* ----------------------------------------------------------------
   In-Game Co-op HUD (UI Toolkit, scaled via UpcycleCityPanelSettings)
   ---------------------------------------------------------------- */

.coop-hud-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    -unity-font-style: bold;
}

/* Session chip: sits under the gameplay HUD location chip (GameHud), kit style.
   This panel uses the 1920x1080 reference (UpcycleCityPanelSettings). */
.coop-hud-bar {
    position: absolute;
    left: 32px;
    top: 96px;
    flex-direction: row;
    align-items: center;
    padding: 4px;
    border-radius: 26px;
    background-color: rgba(28, 30, 33, 0.86);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
}

.coop-hud-pill {
    flex-direction: row;
    align-items: center;
    height: 40px;
    padding-left: 14px;
    padding-right: 10px;
    border-radius: 20px;
}

.coop-hud-pill-text {
    font-size: 19px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
}

.coop-hud-copy-btn {
    height: 40px;
    min-width: 76px;
    margin: 0 0 0 4px;
    padding: 0 16px;
    border-width: 0;
    border-radius: 20px;
    background-color: rgb(52, 55, 60);
    color: rgb(255, 255, 255);
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.coop-hud-copy-btn:hover {
    background-color: rgb(66, 70, 76);
}

.coop-hud-copy-btn--copied {
    background-color: rgb(46, 170, 92);
}

.coop-hud-leave-btn {
    height: 40px;
    min-width: 76px;
    margin: 0 0 0 4px;
    padding: 0 16px;
    border-width: 0;
    border-radius: 20px;
    background-color: rgba(214, 74, 58, 0.9);
    color: rgb(255, 255, 255);
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.coop-hud-leave-btn:hover {
    background-color: rgb(232, 92, 76);
}

/* The city event chip is drawn by the gameplay HUD (GameHud) for solo and co-op alike */
.coop-hud-event {
    display: none;
    position: absolute;
    top: 102px;
    left: 0;
    right: 0;
    align-items: center;
}

.coop-hud-event-pill {
    min-width: 340px;
    height: 42px;
    padding-left: 20px;
    padding-right: 20px;
    border-radius: 21px;
    background-color: rgba(28, 30, 33, 0.9);
    justify-content: center;
    align-items: center;
}

.coop-hud-event-pill--urgent {
    background-color: rgba(214, 74, 58, 0.92);
}

.coop-hud-event-text {
    font-size: 19px;
    color: rgb(242, 194, 27);
    -unity-text-align: middle-center;
}

.coop-hud-event-pill--urgent .coop-hud-event-text {
    color: rgb(255, 255, 255);
}

.coop-hud-nameplates {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.coop-hud-nameplate {
    position: absolute;
    padding: 5px 14px 6px 14px;
    background-color: rgba(28, 30, 33, 0.88);
    border-bottom-width: 3px;
    border-bottom-color: rgb(242, 106, 27);
    border-radius: 14px;
    font-size: 18px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    translate: -50% -100%;
}


/* ----------------------------------------------------------------
   Main Menu title screen (MainMenu scene, MainMenuPanelSettings 1080x608 landscape reference)
   Kit look: transparent over the live 3D backdrop (MenuBackdrop), charcoal rounded cards/chips,
   bold white title, orange stage pill + round PLAY, dark pill buttons with icons, green selected.
   Stream colours: Paper #2E6FB5, Plastic #F2B51B, Glass #2E8B57, Cans #C8463B.
   ---------------------------------------------------------------- */

.mm-root {
    background-color: rgba(0, 0, 0, 0);
    color: rgb(255, 255, 255);
}

/* Scrims are off by default (the kit backdrop art can enable a gradient image here); text uses shadows */
.mm-scrim-right, .mm-scrim-bottom { display: none; }

/* chips */
.mm-chip {
    position: absolute;
    top: 14px;
    height: 36px;
    flex-direction: row;
    align-items: center;
    padding: 0 12px 0 6px;
    border-radius: 18px;
    background-color: rgba(28, 30, 33, 0.88);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
}
.mm-chip--name { left: 18px; }
.mm-chip--info { right: 18px; padding-left: 10px; }

.mm-badge {
    height: 24px;
    padding: 0 9px;
    margin-right: 4px;
    border-radius: 12px;
    background-color: rgb(242, 106, 27);
    font-size: 11px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
}
.mm-name-field {
    width: 150px;
    height: 28px;
    margin: 0;
}
.mm-name-field .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-font-style: bold;
    padding: 0 6px;
    -unity-text-align: middle-left;
}
.mm-chip-icon {
    width: 18px; height: 18px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}
.mm-chip-caption {
    font-size: 13px;
    color: rgb(176, 181, 188);
}
.mm-chip-value {
    font-size: 15px;
    margin-left: 6px;
    color: rgb(255, 255, 255);
}
.mm-chip-divider {
    width: 1px; height: 16px;
    margin: 0 10px;
    background-color: rgba(255, 255, 255, 0.16);
}
.mm-streams { flex-direction: row; }
.mm-stream {
    width: 11px; height: 11px;
    margin-left: 4px;
    border-radius: 3px;
}
.mm-stream--paper { background-color: rgb(46, 111, 181); }
.mm-stream--plastic { background-color: rgb(242, 181, 27); }
.mm-stream--glass { background-color: rgb(46, 139, 87); }
.mm-stream--cans { background-color: rgb(200, 70, 59); }

/* title block */
/* Title column on the right; MenuBackdrop yaws the camera so the character stands in the free strip left of it
   (and right of the Settings/Join/Room card), at any aspect ratio. */
.mm-brand {
    position: absolute;
    right: 24px;
    top: 84px;
    width: 40%;
    max-width: 470px;
    padding: 12px 14px 8px 14px;
    border-radius: 24px;
    background-color: rgba(16, 18, 20, 0.34);
    align-items: flex-end;
}
.mm-logo {
    width: 100%;
    height: 84px;
    background-image: url("project://database/Assets/UpcycleCity/Art/UI/Logo/logo_upcycle_city.png");
    -unity-background-scale-mode: scale-to-fit;
    background-position-x: right;
}
.mm-title {
    display: none;
    font-size: 56px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    letter-spacing: 3px;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-right;
    text-shadow: 0 3px 10px rgba(0, 0, 0, 0.7);
}
.mm-stage-pill {
    flex-direction: row;
    align-items: center;
    height: 32px;
    padding: 0 16px 0 12px;
    margin-top: 2px;
    border-radius: 16px;
    background-color: rgb(226, 98, 40);
}
.mm-stage-dot {
    width: 9px; height: 9px;
    margin-right: 8px;
    border-radius: 5px;
    background-color: rgb(255, 255, 255);
}
.mm-stage-text {
    font-size: 15px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
}
.mm-slogan {
    margin-top: 10px;
    font-size: 16px;
    -unity-font-style: normal;
    color: rgb(244, 244, 240);
    -unity-text-align: middle-right;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
    white-space: normal;
}

.mm-actions {
    width: 100%;
    max-width: 330px;
    margin-top: 14px;
}
.mm-button-row { flex-direction: row; }
.mm-half {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 5px;
}
.mm-half:last-child {
    margin-right: 0;
    margin-left: 5px;
}

/* dark pill buttons with icon + label */
.mm-pill {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 44px;
    margin: 0 0 9px 0;
    padding: 0 14px;
    border-radius: 13px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    background-color: rgba(30, 32, 35, 0.94);
    transition-property: background-color, scale;
    transition-duration: 0.1s;
}
.mm-pill:hover { background-color: rgb(46, 49, 54); }
.mm-pill:active { scale: 0.97 0.97; }
.mm-pill:disabled { opacity: 0.5; }
.mm-pill-icon {
    width: 20px; height: 20px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}
.mm-pill-label {
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
}
.mm-pill--quiet {
    height: 36px;
    background-color: rgba(30, 32, 35, 0.6);
}
.mm-pill--quiet .mm-pill-label { font-size: 13px; color: rgb(200, 204, 210); }
.mm-pill--quiet .mm-pill-icon { width: 14px; height: 14px; }

/* round orange PLAY */
.mm-play {
    position: absolute;
    right: 34px;
    bottom: 26px;
    width: 118px;
    height: 118px;
    margin: 0;
    padding: 0;
    border-radius: 59px;
    border-width: 5px;
    border-color: rgb(255, 255, 255);
    background-color: rgb(242, 106, 27);
    align-items: center;
    justify-content: center;
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}
.mm-play:hover { background-color: rgb(255, 124, 46); scale: 1.04 1.04; }
.mm-play:active { scale: 0.96 0.96; }
.mm-play:disabled { opacity: 0.55; }
.mm-play-icon {
    width: 0; height: 0;
    margin-left: 6px;
    border-left-width: 26px;
    border-top-width: 16px;
    border-bottom-width: 16px;
    border-left-color: rgb(255, 255, 255);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}
.mm-play-label {
    margin-top: 6px;
    font-size: 21px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}
.mm-play-sub {
    margin-top: -4px;
    font-size: 10px;
    letter-spacing: 2px;
    color: rgba(255, 255, 255, 0.85);
}

/* status banner */
.mm-banner {
    position: absolute;
    top: 60px;
    left: 300px;
    right: 300px;
    margin: 0;
}

/* left card: settings / join / connecting / room */
.coop-panel.mm-panel {
    position: absolute;
    left: 18px;
    top: 64px;
    bottom: 18px;
    width: 34%;
    max-width: 380px;
    max-height: none;
    border-radius: 16px;
    border-color: rgba(255, 255, 255, 0.07);
    background-color: rgba(30, 32, 35, 0.95);
}
.mm-root .coop-header {
    height: 48px;
    padding-left: 18px;
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}
.mm-root .coop-header-title { font-size: 17px; letter-spacing: 1px; }
.mm-root .coop-section { padding: 12px 18px 14px 18px; }
.mm-root .coop-label { font-size: 13px; margin-bottom: 6px; color: rgb(176, 181, 188); }
.mm-root .coop-label--spaced { margin-top: 4px; }
.mm-root .coop-input { height: 44px; margin-bottom: 10px; }
.mm-root .coop-input .unity-text-field__input { font-size: 17px; border-radius: 10px; }
.mm-root .coop-input--code .unity-text-field__input { font-size: 22px; }
.mm-root .coop-btn { height: 44px; font-size: 16px; margin-bottom: 8px; border-radius: 12px; }
.mm-root .coop-btn--small { height: 36px; font-size: 14px; }
.mm-root .coop-toggle { height: 40px; font-size: 13px; border-radius: 10px; }
.mm-root .coop-toggle-row { margin-bottom: 8px; }
.mm-root .coop-banner { padding: 8px 12px; border-radius: 12px; }
.mm-root .coop-banner-text { font-size: 14px; }
.mm-root .coop-code-badge { font-size: 19px; padding: 10px; border-radius: 12px; }
.mm-root .coop-code-copy-btn { min-width: 76px; min-height: 44px; font-size: 14px; border-radius: 12px; }
.mm-root .coop-roster-row { height: 40px; margin-bottom: 6px; border-radius: 10px; }
.mm-root .coop-roster-slot { width: 40px; height: 26px; font-size: 13px; border-radius: 8px; }
.mm-root .coop-roster-name { font-size: 15px; }
.mm-root .coop-hint { font-size: 13px; margin-bottom: 10px; }

/* portrait phones: stack */
.coop-root--portrait .mm-brand {
    left: 20px; right: 20px; width: auto;
    top: 70px;
    align-items: center;
}
.coop-root--portrait .mm-title { -unity-text-align: middle-center; font-size: 52px; }
.coop-root--portrait .mm-slogan { -unity-text-align: middle-center; }
.coop-root--portrait .coop-panel.mm-panel {
    left: 16px; right: 16px; width: auto;
    top: auto; bottom: 16px; height: 60%;
}

/* ----------------------------------------------------------------
   Co-op crew card over the Character Creator (UpcycleCityPanelSettings 1920x1080 reference)
   ---------------------------------------------------------------- */

.coop-crew-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    -unity-font-style: bold;
}

.coop-crew-card {
    position: absolute;
    right: 40px;
    top: 40px;
    width: 440px;
    padding: 16px 18px 6px 18px;
    background-color: rgba(30, 34, 36, 0.94);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(47, 143, 138);
}

.coop-crew-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.coop-crew-title {
    font-size: 22px;
    color: rgb(242, 194, 27);
}

.coop-crew-code {
    font-size: 17px;
    color: rgb(198, 214, 210);
    letter-spacing: 2px;
}

.coop-crew-row {
    flex-direction: row;
    align-items: center;
    height: 48px;
    padding: 0 12px;
    margin-bottom: 6px;
    background-color: rgb(46, 50, 54);
    border-radius: 5px;
}

.coop-crew-name {
    flex-grow: 1;
    font-size: 18px;
    color: rgb(236, 240, 242);
    overflow: hidden;
}

.coop-crew-status {
    font-size: 15px;
    -unity-font-style: normal;
    color: rgb(168, 176, 180);
}

.coop-crew-status--ready {
    -unity-font-style: bold;
    color: rgb(98, 214, 140);
}

.coop-crew-hint {
    font-size: 16px;
    -unity-font-style: normal;
    color: rgb(190, 198, 202);
    white-space: normal;
    margin: 6px 0 4px 0;
}

.coop-crew-btn {
    height: 56px;
    font-size: 19px;
    margin-top: 6px;
    margin-bottom: 6px;
}

.coop-crew-root--portrait .coop-crew-card {
    left: 24px;
    right: 24px;
    top: 24px;
    width: auto;
}

/* Round PLAY: kit art (Buttons/btn_round_play.png — ring, glow and triangle baked in); label sits under the triangle */
.mm-play {
    width: 128px;
    height: 128px;
    right: 28px;
    bottom: 20px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/UpcycleCity/Art/UI/Buttons/btn_round_play.png");
    -unity-background-scale-mode: scale-to-fit;
    justify-content: flex-end;
    padding-bottom: 27px;
}
.mm-play:hover { background-color: rgba(0, 0, 0, 0); }
.mm-play:active {
    background-image: url("project://database/Assets/UpcycleCity/Art/UI/Buttons/btn_round_play_pressed.png");
}
.mm-play-icon, .mm-play-sub { display: none; }
.mm-play-label { margin-top: 0; font-size: 17px; }
