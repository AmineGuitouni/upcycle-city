# =============================================================================
# Upcycle City — Unity 6 project .gitignore
# Repo root = this folder (UpcycleCityUnity/).
# Keep every *.meta file tracked: Unity uses them for asset GUIDs.
# =============================================================================

# -----------------------------------------------------------------------------
# Unity generated folders (rebuilt automatically when the project opens)
# -----------------------------------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
[Ii]nstalled/

# Addressables build output
Assets/StreamingAssets/aa/

# -----------------------------------------------------------------------------
# IDE / generated solution and project files (regenerated by Unity)
# -----------------------------------------------------------------------------
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.mdb
*.opendb
*.VC.db
.vs/
.idea/
.consulo/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# -----------------------------------------------------------------------------
# Crash reports and build output
# -----------------------------------------------------------------------------
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage.tmp

# -----------------------------------------------------------------------------
# Local secrets — never commit
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
keys.txt

# -----------------------------------------------------------------------------
# Local AI tool state
# -----------------------------------------------------------------------------
.claude/settings.local.json
.claude/worktrees/

# -----------------------------------------------------------------------------
# OS / editor junk
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
